# VITE_ variables are public in the static bundle. Never put tokens or secrets here.
VITE_CITY_MODE=local
# Set mode to live after configuring your public server and SpacetimeAuth application.
VITE_SPACETIMEDB_URI=http://localhost:3000
VITE_SPACETIMEDB_DATABASE=induskorve-dev
VITE_SPACETIMEAUTH_CLIENT_ID=
# Optional: defaults to this app's base URL. Register that exact URL in SpacetimeAuth.
# VITE_SPACETIMEAUTH_REDIRECT_URI=https://example.com/Induskorve/
